{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BAITC-Hacks/hack-4341ec06-paralax/contracts/planning-input.schema.json",
  "title": "PlanningInput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "as_of_date",
    "warehouse_id",
    "review_period_days",
    "suppliers",
    "products",
    "sales",
    "stockouts"
  ],
  "properties": {
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "warehouse_id": {
      "type": "string",
      "minLength": 1
    },
    "review_period_days": {
      "type": "integer",
      "minimum": 1
    },
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/supplier"
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product"
      }
    },
    "sales": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sale"
      }
    },
    "stockouts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stockout"
      }
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "data_source": {
      "enum": [
        "synthetic",
        "partner_excel"
      ]
    },
    "safety_stock_days": {
      "type": "integer",
      "minimum": 0
    },
    "history_start_date": {
      "type": "string",
      "format": "date"
    },
    "history_end_date": {
      "type": "string",
      "format": "date"
    },
    "source_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "monthly_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "month",
          "quantity",
          "opening_stock"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "month": {
            "type": "string",
            "format": "date"
          },
          "quantity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "opening_stock": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    }
  },
  "$defs": {
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supplier_id",
        "name",
        "lead_time_days"
      ],
      "properties": {
        "supplier_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "lead_time_days": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "name",
        "category",
        "supplier_id",
        "current_stock",
        "goods_in_transit",
        "growth_forecast_pct"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "supplier_id": {
          "type": "string",
          "minLength": 1
        },
        "current_stock": {
          "type": "integer",
          "minimum": 0
        },
        "goods_in_transit": {
          "type": "integer",
          "minimum": 0
        },
        "growth_forecast_pct": {
          "type": "number",
          "minimum": -100
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "stock_as_of_date": {
          "type": "string",
          "format": "date"
        },
        "stock_source": {
          "type": "string",
          "minLength": 1
        },
        "stock_scope": {
          "type": "string",
          "minLength": 1
        },
        "order_multiple": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_order_quantity": {
          "type": "integer",
          "minimum": 0
        },
        "quality_warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shipments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "quantity",
              "expected_date"
            ],
            "properties": {
              "quantity": {
                "type": "integer",
                "minimum": 0
              },
              "expected_date": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "sale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "sku",
        "quantity"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "customer_id": {
          "type": "string",
          "minLength": 1
        },
        "unit_price_kzt": {
          "type": "number",
          "minimum": 0
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "warehouse_id": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "document_id"
          ]
        },
        {
          "required": [
            "customer_id"
          ]
        }
      ]
    },
    "stockout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "start_date",
        "end_date"
      ],
      "properties": {
        "sku": {
          "type": "string",
          "minLength": 1
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": "string",
          "format": "date"
        },
        "certainty": {
          "enum": [
            "confirmed",
            "suspected"
          ]
        }
      }
    }
  }
}
