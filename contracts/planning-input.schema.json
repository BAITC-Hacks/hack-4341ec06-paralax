{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BAITC-Hacks/hack-4341ec06-paralax/contracts/planning-input.schema.json",
  "title": "PlanningInput",
  "type": "object",
  "additionalProperties": false,
  "required": ["as_of_date", "warehouse_id", "review_period_days", "suppliers", "products", "sales", "stockouts"],
  "properties": {
    "as_of_date": {"type": "string", "format": "date"},
    "warehouse_id": {"type": "string", "minLength": 1},
    "review_period_days": {"type": "integer", "minimum": 1},
    "suppliers": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/supplier"}
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/product"}
    },
    "sales": {
      "type": "array",
      "items": {"$ref": "#/$defs/sale"}
    },
    "stockouts": {
      "type": "array",
      "items": {"$ref": "#/$defs/stockout"}
    }
  },
  "$defs": {
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supplier_id", "name", "lead_time_days"],
      "properties": {
        "supplier_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "lead_time_days": {"type": "integer", "minimum": 0}
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "name", "category", "supplier_id", "current_stock", "goods_in_transit", "growth_forecast_pct"],
      "properties": {
        "sku": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "supplier_id": {"type": "string", "minLength": 1},
        "current_stock": {"type": "integer", "minimum": 0},
        "goods_in_transit": {"type": "integer", "minimum": 0},
        "growth_forecast_pct": {"type": "number", "minimum": -100}
      }
    },
    "sale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "sku", "quantity", "customer_id", "unit_price_kzt"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "sku": {"type": "string", "minLength": 1},
        "quantity": {"type": "integer", "minimum": 1},
        "customer_id": {"type": "string", "minLength": 1},
        "unit_price_kzt": {"type": "number", "minimum": 0}
      }
    },
    "stockout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sku", "start_date", "end_date"],
      "properties": {
        "sku": {"type": "string", "minLength": 1},
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"}
      }
    }
  }
}
